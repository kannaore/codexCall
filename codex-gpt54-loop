#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Sequence

from oracle_review import loop_git as loop_git_mod
from oracle_review import loop_review as loop_review_mod
from oracle_review import loop_runtime as loop_runtime_mod

DEFAULT_OUTPUT_DIR = loop_runtime_mod.DEFAULT_OUTPUT_DIR
DEFAULT_MAX_ROUNDS = loop_runtime_mod.DEFAULT_MAX_ROUNDS
DEFAULT_REVIEW_MODEL = loop_runtime_mod.DEFAULT_REVIEW_MODEL
DEFAULT_REVIEW_MODEL_STRATEGY = loop_runtime_mod.DEFAULT_REVIEW_MODEL_STRATEGY
DEFAULT_REVIEW_DELIVERY = loop_runtime_mod.DEFAULT_REVIEW_DELIVERY
DEFAULT_REVIEW_MODE = loop_runtime_mod.DEFAULT_REVIEW_MODE
DEFAULT_REVIEW_TIMEOUT_MS = loop_runtime_mod.DEFAULT_REVIEW_TIMEOUT_MS
DEFAULT_REVIEW_FANOUT_COUNT = loop_runtime_mod.DEFAULT_REVIEW_FANOUT_COUNT
DEFAULT_REVIEW_FANOUT_STRATEGY = loop_runtime_mod.DEFAULT_REVIEW_FANOUT_STRATEGY

ReviewDecision = loop_review_mod.ReviewDecision
run_command = loop_runtime_mod.run_command
read_task = loop_runtime_mod.read_task
parse_thread_id = loop_runtime_mod.parse_thread_id
ensure_text_list = loop_review_mod.ensure_text_list
extract_json_object = loop_review_mod.extract_json_object
effective_review_timeout_ms = loop_review_mod.effective_review_timeout_ms
parse_review_decision = loop_review_mod.parse_review_decision
build_review_prompt = loop_review_mod.build_review_prompt
review_candidate_manifest_path = loop_review_mod.review_candidate_manifest_path
load_review_candidate_manifest = loop_review_mod.load_review_candidate_manifest
build_follow_up_prompt = loop_review_mod.build_follow_up_prompt
print_review_summary = loop_runtime_mod.print_review_summary
confirm_manual_continue = loop_runtime_mod.confirm_manual_continue
build_codex_command = loop_runtime_mod.build_codex_command
review_command_path = loop_runtime_mod.review_command_path
default_session_dir = loop_runtime_mod.default_session_dir
write_text = loop_runtime_mod.write_text
write_manifest = loop_runtime_mod.write_manifest
iter_status_entries = loop_git_mod.iter_status_entries
is_reviewable_status_path = loop_git_mod.is_reviewable_status_path


def detect_repo_root(start: Path) -> Path:
    return loop_git_mod.detect_repo_root(start, run_command_impl=run_command)


def has_repo_changes(repo_root: Path, *, session_dir: Path | None = None) -> bool:
    return loop_git_mod.has_repo_changes(
        repo_root,
        session_dir=session_dir,
        run_command_impl=run_command,
    )


def has_untracked_files(repo_root: Path, *, session_dir: Path | None = None) -> bool:
    return loop_git_mod.has_untracked_files(
        repo_root,
        session_dir=session_dir,
        run_command_impl=run_command,
    )


def run_codex_round(
    *,
    repo_root: Path,
    round_index: int,
    thread_id: str | None,
    prompt: str,
    session_dir: Path,
    args: argparse.Namespace,
) -> str:
    return loop_runtime_mod.run_codex_round(
        repo_root=repo_root,
        round_index=round_index,
        thread_id=thread_id,
        prompt=prompt,
        session_dir=session_dir,
        args=args,
        run_command_impl=run_command,
        write_text_impl=write_text,
        build_codex_command_impl=build_codex_command,
        parse_thread_id_impl=parse_thread_id,
    )


def run_review_round(
    *,
    repo_root: Path,
    round_index: int,
    task: str,
    session_dir: Path,
    args: argparse.Namespace,
) -> tuple[ReviewDecision, Path]:
    return loop_runtime_mod.run_review_round(
        repo_root=repo_root,
        round_index=round_index,
        task=task,
        session_dir=session_dir,
        args=args,
        has_untracked_files_impl=has_untracked_files,
        run_command_impl=run_command,
        write_text_impl=write_text,
        build_review_prompt_impl=build_review_prompt,
        effective_review_timeout_ms_impl=effective_review_timeout_ms,
        review_command_path_impl=review_command_path,
        parse_review_decision_impl=parse_review_decision,
        print_review_summary_impl=print_review_summary,
    )


def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run a recursive Codex -> ChatGPT web review -> Codex improvement loop."
    )
    parser.add_argument("task", nargs="?", help="Initial Codex task. Use '-' to read from stdin.")
    parser.add_argument("--repo", default=".", help="Path inside the target git repository.")
    parser.add_argument("--max-rounds", type=int, default=DEFAULT_MAX_ROUNDS, help="Maximum Codex/review rounds.")
    parser.add_argument(
        "--feedback-mode",
        choices=["auto", "manual"],
        default="auto",
        help="Automatically feed review feedback back into Codex, or pause each round for confirmation.",
    )
    parser.add_argument("--session-dir", default=None, help="Directory for loop artifacts and logs.")
    parser.add_argument("--codex-model", default=None, help="Model passed to `codex exec`.")
    parser.add_argument("--codex-profile", default=None, help="Config profile passed to `codex exec`.")
    parser.add_argument("--codex-full-auto", action="store_true", help="Pass `--full-auto` to Codex.")
    parser.add_argument(
        "--codex-bypass-approvals",
        action="store_true",
        help="Pass `--dangerously-bypass-approvals-and-sandbox` to Codex.",
    )
    parser.add_argument("--codex-session-id", default=None, help="Resume an existing Codex session id instead of starting a new session.")
    parser.add_argument("--codex-resume-last", action="store_true", help="Resume the most recent recorded Codex session instead of starting a new session.")
    parser.add_argument("--review-model", default=DEFAULT_REVIEW_MODEL, help="Visible ChatGPT model label.")
    parser.add_argument(
        "--review-model-strategy",
        default=DEFAULT_REVIEW_MODEL_STRATEGY,
        choices=["select", "current", "ignore"],
        help="How the ChatGPT web runner should handle the model picker.",
    )
    parser.add_argument(
        "--review-delivery",
        default=DEFAULT_REVIEW_DELIVERY,
        choices=["manual", "pinchtab", "cdp"],
        help="How to deliver the review prompt to ChatGPT.",
    )
    parser.add_argument("--cdp-debug-url", default=None, help="Override the Chrome DevTools endpoint when using `--review-delivery cdp`.")
    parser.add_argument(
        "--review-mode",
        default=DEFAULT_REVIEW_MODE,
        choices=["diff", "files", "hybrid"],
        help="Attachment mode forwarded to `codex-gpt54-review`.",
    )
    parser.add_argument(
        "--review-timeout-ms",
        type=int,
        default=DEFAULT_REVIEW_TIMEOUT_MS,
        help="Timeout passed to the ChatGPT review runner.",
    )
    parser.add_argument(
        "--review-fanout-count",
        type=int,
        default=DEFAULT_REVIEW_FANOUT_COUNT,
        help="How many parallel ChatGPT review tabs to run each round.",
    )
    parser.add_argument(
        "--review-fanout-strategy",
        default=DEFAULT_REVIEW_FANOUT_STRATEGY,
        choices=["angled", "identical"],
        help="How the parallel ChatGPT review prompts should differ.",
    )
    parser.add_argument("--review-file", action="append", default=[], dest="review_files", help="Extra file to attach to every review round.")
    parser.add_argument("--include-untracked", action="store_true", help="Include untracked files in review rounds.")
    parser.add_argument("--project-url", default=None, help="Override the ChatGPT project URL for review rounds.")
    parser.add_argument("--no-project-url", action="store_true", help="Do not force a ChatGPT project URL during review.")
    parser.add_argument("--review-note", default="", help="Extra review emphasis appended to the structured review prompt.")
    return parser.parse_args(argv)


def main(argv: Sequence[str] | None = None) -> int:
    return loop_runtime_mod.run_loop(
        parse_args(argv or sys.argv[1:]),
        read_task_impl=read_task,
        detect_repo_root_impl=detect_repo_root,
        default_session_dir_impl=default_session_dir,
        write_manifest_impl=write_manifest,
        run_codex_round_impl=run_codex_round,
        has_repo_changes_impl=has_repo_changes,
        run_review_round_impl=run_review_round,
        load_review_candidate_manifest_impl=load_review_candidate_manifest,
        review_candidate_manifest_path_impl=review_candidate_manifest_path,
        build_follow_up_prompt_impl=build_follow_up_prompt,
        confirm_manual_continue_impl=confirm_manual_continue,
        write_text_impl=write_text,
    )


if __name__ == "__main__":
    raise SystemExit(main())
