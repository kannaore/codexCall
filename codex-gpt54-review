def run_command(args: Sequence[str], cwd: Path) -> str:
    result = subprocess.run(
        list(args),
        cwd=str(cwd),
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def split_non_empty(text: str) -> list[str]:
    return [line.strip() for line in text.splitlines() if line.strip()]


def is_reviewable_path(path: Path) -> bool:
    return path.is_file() and "__pycache__" not in path.parts and path.suffix != ".pyc"


def dedupe_paths(paths: Iterable[Path]) -> list[Path]:
    seen: set[str] = set()
    selected: list[Path] = []
    for path in paths:
        resolved = path.resolve()
        key = str(resolved)
        if key in seen or not resolved.exists() or not is_reviewable_path(resolved):
            continue
        seen.add(key)
        selected.append(resolved)
    return selected


def detect_repo_root(start: Path) -> Path:
    return Path(run_command(["git", "rev-parse", "--show-toplevel"], start))


def detect_branch(repo_root: Path) -> str:
    return run_command(["git", "rev-parse", "--abbrev-ref", "HEAD"], repo_root)


def gather_changed_files(repo_root: Path, *, include_untracked: bool) -> list[Path]:
    staged = split_non_empty(run_command(["git", "diff", "--name-only", "--cached", "--diff-filter=ACMR"], repo_root))
    unstaged = split_non_empty(run_command(["git", "diff", "--name-only", "--diff-filter=ACMR"], repo_root))
    selected = [repo_root / path for path in [*staged, *unstaged]]
    if include_untracked:
        untracked = split_non_empty(run_command(["git", "ls-files", "--others", "--exclude-standard"], repo_root))
        selected.extend(repo_root / path for path in untracked)
    return dedupe_paths(selected)


def build_diff_payload(repo_root: Path) -> str:
    status_text = run_command(["git", "status", "--short"], repo_root)
    staged_diff = run_command(["git", "diff", "--cached", "--find-renames", "--binary", "HEAD"], repo_root)
    unstaged_diff = run_command(["git", "diff", "--find-renames", "--binary"], repo_root)
    return (
        "# Git Diff Review Payload\n\n"
        "## Status\n"
        "```text\n"
        f"{status_text or '(clean working tree)'}\n"
        "```\n\n"
        "## Staged Diff\n"
        "```diff\n"
        f"{staged_diff or '(none)'}\n"
        "```\n\n"
        "## Unstaged Diff\n"
        "```diff\n"
        f"{unstaged_diff or '(none)'}\n"
        "```\n"
    )


def build_context_markdown(
    *,
    repo_root: Path,
    branch: str,
    prompt_text: str,
    selected_files: Sequence[Path],
    status_text: str,
    diff_stat: str,
) -> str:
    rel_files = []
    for path in selected_files:
        try:
            rel_files.append(str(path.relative_to(repo_root)))
        except ValueError:
            rel_files.append(str(path))
    files_block = "\n".join(f"- {path}" for path in rel_files) or "- (none)"
    return f"""# Codex Review Context

Repository: {repo_root.name}
Path: {repo_root}
Branch: {branch}

## Requested Review
{prompt_text.strip()}

## Selected Files
{files_block}

## Git Status
```text
{status_text or "(clean working tree)"}
```

## Diff Stat
```text
{diff_stat or "(no diff stat available)"}
```
"""


def create_temp_context(content: str) -> Path:
    handle = tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".oracle-context.md", delete=False)
    try:
        handle.write(content)
        handle.flush()
        return Path(handle.name)
    finally:
        handle.close()


def default_output_path(repo_root: Path) -> Path:
    output_dir = repo_root / DEFAULT_OUTPUT_DIR
    output_dir.mkdir(parents=True, exist_ok=True)
    return output_dir / f"review-{datetime.now().strftime('%Y%m%d-%H%M%S')}.md"


def read_file_excerpt(path: Path) -> str:
    text = path.read_text(encoding="utf-8", errors="replace")
    if len(text) <= MAX_FILE_CHARS:
        return text
    return text[:MAX_FILE_CHARS] + "\n\n[truncated]\n"


def build_bundle_text(
    *,
    repo_root: Path,
    prompt_text: str,
    context_text: str,
    attachments: Sequence[Path],
    begin_marker: str,
    end_marker: str,
) -> str:
    parts = [
        "You are reviewing a local coding change from Codex.",
        "Return the final answer in Korean.",
        "Wrap the full answer exactly between these markers:",
        begin_marker,
        end_marker,
        "",
        context_text.strip(),
        "",
        "## Attached Material",
    ]
    remaining = MAX_BUNDLE_CHARS
    for attachment in attachments:
        body = read_file_excerpt(attachment)
        header = f"\n### {attachment.name}\n"
        block = header + "```text\n" + body + "\n```\n"
        if len(block) > remaining:
            parts.append("\n[remaining attachments omitted due to bundle cap]\n")
            break
        parts.append(block)
        remaining -= len(block)
    parts.append("\n## Review Request\n")
    parts.append(prompt_text.strip())
    return "\n".join(parts)


def write_windows_temp_file(name: str, content: str) -> Path:
    WINDOWS_TEMP_DIR.mkdir(parents=True, exist_ok=True)
    path = WINDOWS_TEMP_DIR / name
    path.write_text(content, encoding="utf-8")
    return path


def windows_temp_path(name: str) -> Path:
    WINDOWS_TEMP_DIR.mkdir(parents=True, exist_ok=True)
    return WINDOWS_TEMP_DIR / name


def to_windows_path(path: Path) -> str:
    if os.environ.get("WSL_DISTRO_NAME"):
        return run_command(["wslpath", "-m", str(path)], Path.cwd())
    return str(path)


def decode_windows_bytes(data: bytes) -> str:
    for encoding in ("utf-8", "cp949", "utf-8-sig"):
        try:
            return data.decode(encoding)
        except UnicodeDecodeError:
            continue
    return data.decode("utf-8", errors="replace")


def run_windows_powershell(script_text: str, *, script_name: str) -> subprocess.CompletedProcess[bytes]:
    ps_script = write_windows_temp_file(script_name, script_text)
    ps = "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
    try:
        return subprocess.run(
            [
                ps,
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                to_windows_path(ps_script),
            ],
            check=False,
            capture_output=True,
        )
    finally:
        try:
            ps_script.unlink(missing_ok=True)
        except TypeError:
            if ps_script.exists():
                ps_script.unlink()


